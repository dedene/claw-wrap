[Unit]
Description=Claw-Wrap Secrets Daemon
Documentation=https://github.com/dedene/claw-wrap
After=network.target

[Service]
Type=simple
# TODO: Set to your username (the user that owns the pass/GPG store)
User=YOUR_USERNAME
ExecStart=/usr/local/bin/claw-wrap daemon
Restart=always
RestartSec=5

# Create runtime directory for socket (preserve contents across restarts)
RuntimeDirectory=openclaw
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes

# $HOME is set automatically by systemd when User= is configured.
# GPG uses $HOME/.gnupg by default. If your GPG home is elsewhere, add:
#   Environment=GNUPGHOME=/path/to/.gnupg

# ── Security hardening ──────────────────────────────────────────────
# claw-wrap spawns child processes (gh, bird, gog, …) that inherit
# all restrictions below. Only enable options compatible with the
# tools you configure.
#
# SAFE — restrict daemon + children without breaking tools:
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
# If tools need to write to home directories (e.g., git fetch/push to a workspace),
# add: ReadWritePaths=/home/YOUR_USERNAME/your-workspace
ReadWritePaths=/run/openclaw
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictNamespaces=true
UMask=0077
SystemCallArchitectures=native
SystemCallFilter=@system-service

# TOOL-DEPENDENT — adjust based on your configured tools:
#
# Network access: tools that call external APIs (gh, gog, strawpoll)
# need AF_INET/AF_INET6. Node/libuv may also need AF_NETLINK to
# enumerate network interfaces. Only use AF_UNIX alone if ALL tools
# are local/offline.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
#
# JIT memory: Node.js (bird), Python, and other runtimes with JIT
# compilers need writable+executable memory. Set to true only if
# none of your tools use JIT runtimes.
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target
