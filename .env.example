# OpenClaw image (pinned semver tag)
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.2.21

# Sidecar image.
# Keep `claw-wrap-sidecar:local` for local builds; set GHCR tag when published.
CLAW_WRAP_SIDECAR_IMAGE=claw-wrap-sidecar:local
# Baked package-manager tracks used at image build time.
PNPM_TRACK=10
YARN_TRACK=4

# Host-mounted OpenClaw state/config directory (real config lives here)
OPENCLAW_CONFIG_DIR=./.openclaw
OPENCLAW_WORKSPACE_DIR=./.openclaw/workspace
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_GATEWAY_BIND=lan

# Wrapper config source mounted into sidecar as /etc/openclaw/wrappers.yaml
CLAW_WRAP_WRAPPERS_FILE=./wrappers.yaml

# Runtime user/group mapping for shared /run/openclaw permissions
OPENCLAW_UID=1000
DAEMON_UID=1000
OPENCLAW_SHARED_GID=2000

# Shared runtime permission profile
AUTH_MODE=0640
SOCKET_MODE=0660

# Space-separated runtime install lists.
# Empty means "install nothing extra at runtime".
APT_PACKAGES=""
BREW_PACKAGES=""
NPM_GLOBAL_PACKAGES=""

# Optional provider credentials used by OpenClaw
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENCLAW_GATEWAY_TOKEN=

# Optional: only needed if you add gh/github-token routes to wrappers.yaml.
GITHUB_TOKEN=
